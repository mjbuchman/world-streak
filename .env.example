# Copy this file to .env.local and fill in the values. Never commit .env.local.
# For local development, start Supabase with `npm run db:start`, then copy the values
# printed by `npx supabase status` (API URL, anon key, service_role key).

# Supabase API URL. Local default shown; in production, the project URL from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key: safe in the browser, because row-level security limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status

# Service role key: bypasses row-level security. Server only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status

# Google sign-in (read by the Supabase CLI from supabase/config.toml, not by the app).
# Local Supabase starts with these placeholders; "Continue with Google" only completes with
# a real OAuth client from Google Cloud Console (see docs/NEEDS_HUMAN.md, task T15).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret

{
  "name": "world-streak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "seed:dev": "node --env-file-if-exists=.env.local scripts/seed-dev.mts",
    "close-day": "node --env-file-if-exists=.env.local scripts/close-day.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "supabase": "3.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
